# Required for extraction (CLI and review-app uploads)
ANTHROPIC_API_KEY=sk-ant-...

# Optional (defaults shown)
VOLTSCOPE_MODEL=claude-opus-4-8
VOLTSCOPE_BILLS_DIR=bills
VOLTSCOPE_OUT_DIR=out
VOLTSCOPE_LOG_LEVEL=INFO
VOLTSCOPE_DB=voltscope.db

# API authentication (comma-separated). Leave unset to run open (local dev).
VOLTSCOPE_API_KEYS=

# Review app (python -m voltscope.api)
VOLTSCOPE_HOST=127.0.0.1
VOLTSCOPE_PORT=8000

# Intelligence: flag unit rates above this multiple of the portfolio median.
VOLTSCOPE_HIGH_RATE_MULTIPLIER=1.3
